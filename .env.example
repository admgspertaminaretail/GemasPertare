# ===== GEMAS environment =====
# Wajib di produksi: string acak minimal 32 karakter untuk menandatangani sesi.
AUTH_SECRET=ganti-dengan-string-acak-minimal-32-karakter-xxxxxxxx

# Tampilkan akun demo di halaman login dan izinkan reset data demo (set "false" di produksi).
DEMO_MODE=true

# ---- Database: "local" (file JSON, untuk demo/dev) atau "sheets" (Google Sheets) ----
DB_DRIVER=local
GOOGLE_SHEETS_ID=
# Service Account (JANGAN pernah diberi prefix NEXT_PUBLIC_). Private key: ganti newline dengan \n
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# ---- Penyimpanan file: "local" (folder data/uploads) atau "drive" (Google Drive) ----
FILE_DRIVER=local
GOOGLE_DRIVE_FOLDER_ID=

# Batas ukuran file (MB). Catatan: fungsi serverless Vercel membatasi body request ~4.5 MB.
MAX_FILE_MB=4

# ---- AI (RAG) ----
# Jika kosong, Tanya si GEMAS menampilkan kutipan dokumen resmi tanpa LLM.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
